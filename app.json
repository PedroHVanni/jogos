{
  "expo": {
    "name": "jogos",
    "slug": "jogos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-rpg.png",
    "backgroundColor": "#25292e",
    "scheme": "jogos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pedro_herique_vanni.jogos"
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-rpg.png",
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.pedro_herique_vanni.jogos"
    },

    "web": {
      "output": "static"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-rpg.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O $(PRODUCT_NAME) precisa acessar suas fotos para que você possa enviar imagens para o aplicativo.k",
          "cameraPermission": "O $(PRODUCT_NAME) precisa acessar sua câmera para que você possa tirar fotos."
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "14c9031a-03e0-4a52-8d7d-b9b7ddd562e9"
      }
    },

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "url": "https://u.expo.dev/14c9031a-03e0-4a52-8d7d-b9b7ddd562e9"
    }
  }
}